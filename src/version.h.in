#define AION_VERSION "@PROJECT_VERSION@"
#define AION_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define AION_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define AION_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Build details for the About page and bug reports
