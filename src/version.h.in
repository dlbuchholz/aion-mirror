#ifndef VERSION_H
#define VERSION_H

// Generated by CMake from src/version.h.in. Change the version in CMakeLists.txt:
// project(<name> VERSION ...). The name is in appname.h.
#define APP_VERSION "@PROJECT_VERSION@"
#define APP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define APP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define APP_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Build details for the About page and bug reports
#define APP_GIT_COMMIT "@APP_GIT_COMMIT@"
#define APP_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define APP_COMPILER "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@"

#endif // VERSION_H
