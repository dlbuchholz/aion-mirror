#define AION_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define AION_COMPILER "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@"

#endif // VERSION_H
