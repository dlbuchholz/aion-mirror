// Generated by CMake from translations/aion_<code>.ts (cmake/TranslationProgress.cmake); the
// build updates it when a .ts file changes.
#ifndef TRANSLATIONPROGRESS_H
#define TRANSLATIONPROGRESS_H

struct TranslationProgress {
    const char* code;
    int translated;
    int total;
};

// One entry per translation, then an empty one
inline constexpr TranslationProgress TranslationProgresses[] = {
@AION_TRANSLATION_PROGRESS@    {"", 0, 0},
};

#endif // TRANSLATIONPROGRESS_H
