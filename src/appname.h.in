#ifndef APPNAME_H
#define APPNAME_H

// Generated by CMake from src/appname.h.in. The program's name, for everything that shows it:
// the first word of project(<name> VERSION ...) in CMakeLists.txt. Its own header, apart from
// version.h, whose commit changes with every configure, so a new commit doesn't rebuild the
// files that only show the name.
#define APP_NAME "@PROJECT_NAME@"

#endif // APPNAME_H
